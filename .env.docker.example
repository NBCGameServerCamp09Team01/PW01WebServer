# 이미지를 로컬에서 실행할 때(README "6. 이미지") docker run --env-file .env.docker 로 넣는 값
# 사용: copy .env.docker.example .env.docker → 비밀번호 두 개는 .env와 같은 값을 넣는다(.env.docker는 커밋되지 않음)
# 주소의 mysql·redis는 compose 서비스 이름이다(컨테이너를 compose 네트워크에 붙이므로 localhost가 아님)
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://mysql:3306/{DB이름}
DB_USERNAME=
DB_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=